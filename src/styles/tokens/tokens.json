{
  "$schema": "https://design-tokens.org/format",
  "meta": {
    "name": "crossborder-tokens",
    "description": "Single source of truth for CrossBorder design tokens. Derived from docs/02-design-system.md and docs/04-animation-plan.md. Compiles to CSS custom properties consumed by every component.",
    "version": "0.1.0"
  },
  "color": {
    "brand": {
      "indigo": "#5B5BF0",
      "violet": "#8B5CF6",
      "cyan": "#22D3EE"
    },
    "profit": "#10B981",
    "signal": "#F59E0B",
    "error": "#F43F5E",
    "gradient": {
      "aurora": "linear-gradient(120deg, #5B5BF0 0%, #8B5CF6 45%, #22D3EE 100%)"
    },
    "dark": {
      "bg": "#08090B",
      "surface-1": "#0E1013",
      "surface-2": "#16181D",
      "surface-3": "#1E2127",
      "border": "#26292F",
      "border-strong": "#363A42",
      "text-primary": "#F5F6F7",
      "text-secondary": "#A0A5AE",
      "text-tertiary": "#6B7079"
    },
    "light": {
      "bg": "#FFFFFF",
      "surface-1": "#FAFAFB",
      "surface-2": "#F2F3F5",
      "surface-3": "#E8EAED",
      "border": "#E3E5E9",
      "border-strong": "#CDD1D7",
      "text-primary": "#0A0B0D",
      "text-secondary": "#4A4F58",
      "text-tertiary": "#8A8F98"
    }
  },
  "font": {
    "family": {
      "display": "General Sans, sans-serif",
      "body": "Inter, sans-serif",
      "mono": "Geist Mono, monospace"
    },
    "size": {
      "display": "clamp(3rem, 6vw + 1rem, 5.25rem)",
      "h1": "clamp(2.25rem, 4vw + 1rem, 3.5rem)",
      "h2": "clamp(1.75rem, 2.5vw + 1rem, 2.5rem)",
      "h3": "clamp(1.375rem, 1vw + 1rem, 1.75rem)",
      "body-lg": "clamp(1.125rem, 0.5vw + 1rem, 1.25rem)",
      "body": "1rem",
      "sm": "0.875rem",
      "eyebrow": "0.8125rem"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 550, "bold": 600 },
    "leading": { "display": 1.02, "heading": 1.12, "body": 1.6, "tight": 1.06 },
    "tracking": { "eyebrow": "0.08em", "tight": "-0.01em" }
  },
  "space": {
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "6": "24px", "8": "32px", "12": "48px", "16": "64px",
    "24": "96px", "32": "128px", "40": "160px"
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "xl": "24px", "full": "9999px" },
  "layout": {
    "container": "1200px",
    "container-wide": "1440px",
    "gutter": "24px",
    "gutter-mobile": "16px",
    "section-y": "clamp(64px, 10vw, 160px)"
  },
  "elevation": {
    "card": "0 0 0 1px var(--border)",
    "raised": "0 8px 24px rgba(0,0,0,0.4)",
    "overlay-blur": "16px",
    "glow-brand": "0 0 40px -8px rgba(91,91,240,0.5)"
  },
  "motion": {
    "duration": {
      "instant": "100ms", "fast": "180ms", "base": "280ms",
      "slow": "500ms", "ambient": "12s"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "stagger": "60ms",
    "spring": { "stiffness": 300, "damping": 30 }
  },
  "z": { "base": 0, "sticky": 100, "overlay": 200, "modal": 300, "toast": 400 },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1440px" }
}
